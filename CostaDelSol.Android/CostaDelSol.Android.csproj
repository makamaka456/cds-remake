        <AndroidAsset Include="..\asset\ship-g0\*.png" Link="Assets\ship-g0\%(Filename)%(Extension)" />
        <AndroidAsset Include="..\asset\ship-g1\*.png" Link="Assets\ship-g1\%(Filename)%(Extension)" />
        <AndroidAsset Include="..\asset\ship-g2\*.png" Link="Assets\ship-g2\%(Filename)%(Extension)" />
        <AndroidAsset Include="..\asset\ship-g3\*.png" Link="Assets\ship-g3\%(Filename)%(Extension)" />
        <AndroidAsset Include="..\CdsHelper\cities.json" Link="Assets\cities.json" />
        <!-- PC 판이 실행 파일 옆에서 읽는 자료(후원자 · 힌트 · 아이템 · 책 · 발견물 · 인물표 · 사건 · 이야기 대본) — 앱 폴더로 꺼낸다 -->
        <AndroidAsset Include="..\CdsHelper\*.json" Link="Assets\root\%(Filename)%(Extension)" />
        <!-- 원본 화면 조각 — 메뉴 띠와 타이틀 바탕 -->
        <AndroidAsset Include="..\asset\ui\band\*.png" Link="Assets\ui\band\%(Filename)%(Extension)" />
        <AndroidAsset Include="..\asset\title\*.png" Link="Assets\title\%(Filename)%(Extension)" />
        <!-- 원본 글꼴 — 한글 ALL_FONT.16P(16x14) · 반각 ANKFONT.DAT(8x16) -->
        <AndroidAsset Include="..\asset\ALL_FONT.16P" Link="Assets\font\ALL_FONT.16P" />
        <AndroidAsset Include="..\asset\ANKFONT.DAT" Link="Assets\font\ANKFONT.DAT" />
    </ItemGroup>

    <!--
      원본 자료 — map-assets 릴리즈의 CDSX 스무 개(world · OCEAN · CITYCG · DISCOVER · …)를 Assets/game 에,
      배경음악 28곡을 Assets/bgm 에 둔다. 저장소에는 넣지 않고(.gitignore) 빌드 전에 받는다(워크플로).
      로컬에서 빌드하려면 같은 자리에 받아 두면 된다.
    -->
    <ItemGroup>
        <!-- asset 폴더 전부(효과음 · 아이템 · 해전 · 일기토 · 포커 · 미니게임 · 영상 …). 배경음악은 따로 싣는다. -->
        <AndroidAsset Include="..\asset\**\*" Exclude="..\asset\bgm\**;..\asset\**\*.md"
                      Link="Assets\asset\%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <!-- PC 판 화면 코드(WPF)와 이름이 겹치는 것(Button · Application · Orientation …)이 많아 Android.App · Android.Widget 은 파일마다 따로 부른다 -->
    <ItemGroup>
        <Using Remove="Android.App" />
        <Using Remove="Android.Widget" />
    </ItemGroup>

    <!-- 도구 앱 화면들의 뷰모델(PC 판 그대로)이 쓴다 -->
    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    </ItemGroup>

</Project>
