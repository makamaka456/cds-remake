<Project Sdk="Microsoft.NET.Sdk">

    <!--
      안드로이드판 놀이 앱. 1단계는 세계지도만 띄운다.
      cds-helper.sln 에는 넣지 않는다 — 안드로이드 워크로드가 없는 Windows PC 에서
      sln 빌드(run-game · port-original 스킬)가 깨지기 때문이다. 따로 빌드한다:
        dotnet publish CostaDelSol.Android/CostaDelSol.Android.csproj -c Release -f net10.0-android
    -->
    <PropertyGroup>
        <TargetFramework>net10.0-android</TargetFramework>
        <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- 'CostaDelSol.Android' 로 하면 안에서 Android.* 이름을 가린다. -->
        <RootNamespace>CostaDelSol.Droid</RootNamespace>
        <AssemblyName>CostaDelSol</AssemblyName>
        <ApplicationId>io.github.makamaka456.costadelsol</ApplicationId>
        <ApplicationTitle>대항해시대3</ApplicationTitle>
        <!-- CI 에서 -p:ApplicationVersion=실행번호 -p:ApplicationDisplayVersion=태그 로 덮는다. -->
        <ApplicationVersion>1</ApplicationVersion>
        <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
        <!-- 릴리즈에 바로 올려 설치할 수 있게 aab 가 아니라 apk 로 낸다. 서명은 디버그 키다. -->
        <AndroidPackageFormat>apk</AndroidPackageFormat>
        <!--
          엔진의 표는 System.Text.Json 리플렉션으로 읽는다. 릴리즈 빌드의 트리밍이 그 길을 끄지 않게 켜 두고,
          우리 어셈블리는 손대지 않게 한다(partial: 프레임워크만 깎는다).
        -->
        <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
        <TrimMode>partial</TrimMode>
        <!-- 배경음악은 APK 안에서 바로 튼다(파일로 꺼내지 않는다) — 눌러 담으면 그 자리에서 못 연다. -->
        <AndroidStoreUncompressedFileExtensions>.mp3</AndroidStoreUncompressedFileExtensions>
    </PropertyGroup>

    <!--
      PC 판 게임 엔진 가운데 WPF 를 안 쓰는 것들은 원본 파일을 그대로 끌어다 쓴다 — 고치면 양쪽에 같이 들어간다.
      제독(Player) · 배 · 보급 · 항해 속도(Sailing) · 바람/해류(WindTable) · 지형(TerrainTable) · 돛 효율 ·
      도시 표 · 하루치 바다 사건(SeaEvents) 이 여기 든다. WPF 가 섞인 자리는 원본에서 #if !ANDROID 로 가렸다.
    -->
    <ItemGroup>
        <!-- devtools/ 는 개발 도구(시뮬레이터·검사 스크립트)라 APK 에 컴파일하지 않는다 -->
        <Compile Remove="devtools\**" />
        <None Remove="devtools\**" />
    </ItemGroup>

